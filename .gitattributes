* text=auto

# Text files use Windows-friendly line endings in the working tree.
*.py text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.json text eol=crlf
*.csv text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.toml text eol=crlf
*.ini text eol=crlf
*.html text eol=crlf
*.css text eol=crlf
*.js text eol=crlf
*.bat text eol=crlf
*.cypher text eol=crlf

# Media must never be modified by line-ending conversion.
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.svg binary
*.ico binary
*.pdf binary

